int m;
int n;
int d;
int cuenta = 0;
bool primo;

cin >> m;

n = 2;
while (n < m) {
    primo = true;
    d = 2;
    while (d * d <= n && primo) {
        if (n % d == 0) {
            primo = false;
        }
        d = d + 1;
    }
    if (primo) {
        cuenta = cuenta + 1;
    }
    n = n + 1;
}

cout << "Cantidad de primos menores a M:";
cout << cuenta;
