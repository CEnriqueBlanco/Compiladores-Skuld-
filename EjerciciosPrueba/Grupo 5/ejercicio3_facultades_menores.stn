int matricula;
int carrera;
int semestre;
float promedio;
int aceptado = 0;

cout << "Escribe la matricula del alumno:\n";
cin >> matricula;
cout << "Escribe la carrera (1=Economia, 2=Computacion, 3=Administracion, 4=Contabilidad):\n";
cin >> carrera;
cout << "Escribe el semestre:\n";
cin >> semestre;
cout << "Escribe el promedio:\n";
cin >> promedio;

if (carrera == 1) {
    if (semestre >= 6 && promedio >= 8.8) {
        aceptado = 1;
    }
} else {
    if (carrera == 2) {
        if (semestre > 6 && promedio > 8.5) {
            aceptado = 1;
        }
    } else {
        if (carrera == 3) {
            if (semestre > 5 && promedio > 8.5) {
                aceptado = 1;
            }
        } else {
            if (carrera == 4) {
                if (semestre > 5 && promedio > 8.5) {
                    aceptado = 1;
                }
            }
        }
    }
}

cout << "Matricula:\n";
cout << matricula;
cout << "Carrera:\n";
cout << carrera;
cout << "Aceptado=1:\n";
cout << aceptado;
