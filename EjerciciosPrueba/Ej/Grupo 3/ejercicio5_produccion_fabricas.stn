int n;
int i;
int mes;
int clave;
float produccion;
float total;
float julio;
float mayor_total = 0.0 - 1.0;
int mayor_clave = 0;

cout << "Escribe el numero de fabricas:\n";
cin >> n;

i = 1;
while (i <= n) {
    cout << "Escribe la clave de la fabrica:\n";
    cin >> clave;
    total = 0.0;
    julio = 0.0;

    mes = 1;
    while (mes <= 12) {
        cout << "Escribe la produccion del mes:\n";
        cin >> produccion;
        total = total + produccion;
        if (mes == 7) {
            julio = produccion;
        }
        mes = mes + 1;
    }

    cout << "Fabrica:\n";
    cout << clave;
    cout << "Total anual:\n";
    cout << total;

    if (total > mayor_total) {
        mayor_total = total;
        mayor_clave = clave;
    }

    if (julio > 3000000.0) {
        cout << "Fabrica con julio mayor a 3000000:\n";
        cout << clave;
    }

    i = i + 1;
}

cout << "Fabrica con mayor produccion anual:\n";
cout << mayor_clave;
cout << "Total producido:\n";
cout << mayor_total;
