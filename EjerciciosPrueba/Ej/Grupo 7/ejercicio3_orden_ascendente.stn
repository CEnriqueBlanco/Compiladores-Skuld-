int a;
int b;
int c;
int temp;

cout << "Escribe el primer numero entero:\n";
cin >> a;
cout << "Escribe el segundo numero entero:\n";
cin >> b;
cout << "Escribe el tercer numero entero:\n";
cin >> c;

if (a > b) {
    temp = a;
    a = b;
    b = temp;
}
if (a > c) {
    temp = a;
    a = c;
    c = temp;
}
if (b > c) {
    temp = b;
    b = c;
    c = temp;
}

cout << "Orden ascendente:\n";
cout << a;
cout << b;
cout << c;
