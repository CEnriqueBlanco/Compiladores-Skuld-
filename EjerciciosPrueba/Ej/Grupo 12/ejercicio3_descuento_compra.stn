float monto;
float descuento;
float total;

cout << "Escribe el monto de la compra:\n";
cin >> monto;

if (monto < 500.0) {
    descuento = 0.0;
} else {
    if (monto <= 1000.0) {
        descuento = monto * 0.05;
    } else {
        if (monto <= 7000.0) {
            descuento = monto * 0.11;
        } else {
            if (monto <= 15000.0) {
                descuento = monto * 0.18;
            } else {
                descuento = monto * 0.25;
            }
        }
    }
}

total = monto - descuento;

cout << "Descuento:\n";
cout << descuento;
cout << "Total a pagar:\n";
cout << total;
