int clave;
float minutos;
float precio;
float costo;

cout << "Escribe la clave de la zona:\n";
cin >> clave;
cout << "Escribe los minutos hablados:\n";
cin >> minutos;

if (clave == 12) {
    precio = 2.0;
} else {
    if (clave == 15) {
        precio = 2.2;
    } else {
        if (clave == 18) {
            precio = 4.5;
        } else {
            if (clave == 19) {
                precio = 3.5;
            } else {
                if (clave == 23) {
                    precio = 6.0;
                } else {
                    if (clave == 25) {
                        precio = 6.0;
                    } else {
                        if (clave == 29) {
                            precio = 5.0;
                        } else {
                            precio = 0.0;
                        }
                    }
                }
            }
        }
    }
}

costo = precio * minutos;

cout << "Costo total de la llamada:\n";
cout << costo;
