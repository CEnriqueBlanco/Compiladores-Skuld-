write 'Escribe la categoria del trabajador (1-4):\n'
read categoria
write 'Escribe el sueldo del trabajador:\n'
read sueldo
t1 = categoria == 1
ifFalse t1 goto L1
t2 = sueldo * 0.15
aumento = t2
goto L2
L1:
t3 = categoria == 2
ifFalse t3 goto L3
t4 = sueldo * 0.1
aumento = t4
goto L4
L3:
t5 = categoria == 3
ifFalse t5 goto L5
t6 = sueldo * 0.08
aumento = t6
goto L6
L5:
t7 = categoria == 4
ifFalse t7 goto L7
t8 = sueldo * 0.07
aumento = t8
goto L8
L7:
aumento = 0.0
L8:
L6:
L4:
L2:
t9 = sueldo + aumento
nuevo = t9
write 'Categoria:\n'
write categoria
write 'Nuevo sueldo:\n'
write nuevo
