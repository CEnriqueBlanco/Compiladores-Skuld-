int numero;
int ceros = 0;

cout << "Escribe un numero (-1 para terminar):\n";
cin >> numero;

while (numero != 0 - 1) {
    if (numero == 0) {
        ceros = ceros + 1;
    }
    cout << "Escribe el siguiente numero (-1 para terminar):\n";
    cin >> numero;
}

cout << "Cantidad de ceros:\n";
cout << ceros;
