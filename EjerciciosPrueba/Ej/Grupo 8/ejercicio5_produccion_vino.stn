int n;
int anio;
float v1;
float v2;
float v3;
float v4;
float v5;
float t1 = 0.0;
float t2 = 0.0;
float t3 = 0.0;
float t4 = 0.0;
float t5 = 0.0;
float total_anio;
float maximo_tipo2 = 0.0 - 1.0;
int anio_maximo = 0;

cout << "Escribe el numero de anios:\n";
cin >> n;

anio = 1;
while (anio <= n) {
    cout << "Escribe la produccion del vino tipo 1:\n";
    cin >> v1;
    cout << "Escribe la produccion del vino tipo 2:\n";
    cin >> v2;
    cout << "Escribe la produccion del vino tipo 3:\n";
    cin >> v3;
    cout << "Escribe la produccion del vino tipo 4:\n";
    cin >> v4;
    cout << "Escribe la produccion del vino tipo 5:\n";
    cin >> v5;

    t1 = t1 + v1;
    t2 = t2 + v2;
    t3 = t3 + v3;
    t4 = t4 + v4;
    t5 = t5 + v5;
    total_anio = v1 + v2 + v3 + v4 + v5;

    cout << "Anio:\n";
    cout << anio;
    cout << "Total del anio:\n";
    cout << total_anio;

    if (v2 > maximo_tipo2) {
        maximo_tipo2 = v2;
        anio_maximo = anio;
    }

    if (v3 == 0.0) {
        cout << "Anio sin produccion de vino tipo 3:\n";
        cout << anio;
    }

    anio = anio + 1;
}

cout << "Total tipo 1:\n";
cout << t1;
cout << "Total tipo 2:\n";
cout << t2;
cout << "Total tipo 3:\n";
cout << t3;
cout << "Total tipo 4:\n";
cout << t4;
cout << "Total tipo 5:\n";
cout << t5;
cout << "Anio con mayor produccion tipo 2:\n";
cout << anio_maximo;
cout << "Mayor cantidad tipo 2:\n";
cout << maximo_tipo2;
