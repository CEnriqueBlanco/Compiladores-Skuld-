int tipo;
float duracion;
float costo;
float total = 0.0;
int locales = 0;

cout << "Escribe el tipo de llamada (1=Internacional, 2=Nacional, 3=Local, -1=Terminar):\n";
cin >> tipo;

while (tipo != 0 - 1) {
    cout << "Escribe la duracion en minutos:\n";
    cin >> duracion;

    if (tipo == 1) {
        if (duracion <= 3.0) {
            costo = 7.59;
        } else {
            costo = 7.59 + (duracion - 3.0) * 3.03;
        }
    } else {
        if (tipo == 2) {
            if (duracion <= 3.0) {
                costo = 1.20;
            } else {
                costo = 1.20 + (duracion - 3.0) * 0.48;
            }
        } else {
            locales = locales + 1;
            if (locales > 50) {
                costo = 0.60;
            } else {
                costo = 0.0;
            }
        }
    }

    total = total + costo;
    cout << "Costo de la llamada:\n";
    cout << costo;

    cout << "Escribe el tipo de la siguiente llamada (1=Internacional, 2=Nacional, 3=Local, -1=Terminar):\n";
    cin >> tipo;
}

cout << "Total a pagar:\n";
cout << total;
