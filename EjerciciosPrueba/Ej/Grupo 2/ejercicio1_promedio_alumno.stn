int matricula;
float c1;
float c2;
float c3;
float c4;
float c5;
float suma = 0.0;
float promedio = 0.0;

cout << "Escribe la matricula del alumno:\n";
cin >> matricula;
cout << "Escribe la calificacion 1:\n";
cin >> c1;
cout << "Escribe la calificacion 2:\n";
cin >> c2;
cout << "Escribe la calificacion 3:\n";
cin >> c3;
cout << "Escribe la calificacion 4:\n";
cin >> c4;
cout << "Escribe la calificacion 5:\n";
cin >> c5;

suma = c1 + c2 + c3 + c4 + c5;
promedio = suma / 5.0;

cout << "Matricula:\n";
cout << matricula;
cout << "\n";
cout << "Promedio:\n";
cout << promedio;
