int monto;
int hasta200 = 0;
int entre200y400 = 0;
int desde400 = 0;

cin >> monto;

while (monto != 0 - 1) {
    if (monto <= 200) {
        hasta200 = hasta200 + 1;
    } else {
        if (monto < 400) {
            entre200y400 = entre200y400 + 1;
        } else {
            desde400 = desde400 + 1;
        }
    }
    cin >> monto;
}

cout << "Ventas de 200 o menos:";
cout << hasta200;
cout << "Ventas mayores a 200 e inferiores a 400:";
cout << entre200y400;
cout << "Ventas de 400 o mas:";
cout << desde400;
