float peso_libras;
float longitud_pies;
float peso_kilos;
float longitud_metros;

cout << "Escribe el peso en libras:\n";
cin >> peso_libras;
cout << "Escribe la longitud en pies:\n";
cin >> longitud_pies;

peso_kilos = peso_libras * 0.453592;
longitud_metros = longitud_pies * 0.3048;

cout << "Peso en kilogramos:\n";
cout << peso_kilos;
cout << "Longitud en metros:\n";
cout << longitud_metros;
