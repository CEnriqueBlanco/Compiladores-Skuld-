int tipo;
int edad;
int dias;
float costo_dia;
float total;

cout << "Escribe el tipo de enfermedad (1-4):\n";
cin >> tipo;
cout << "Escribe la edad del paciente:\n";
cin >> edad;
cout << "Escribe los dias de internacion:\n";
cin >> dias;

if (tipo == 1) {
    costo_dia = 25.0;
} else {
    if (tipo == 2) {
        costo_dia = 16.0;
    } else {
        if (tipo == 3) {
            costo_dia = 20.0;
        } else {
            if (tipo == 4) {
                costo_dia = 32.0;
            } else {
                costo_dia = 0.0;
            }
        }
    }
}

total = costo_dia * dias;

if (edad >= 14 && edad <= 22) {
    total = total * 1.10;
}

cout << "Costo total del paciente:\n";
cout << total;
