t1 = 0.0 - 1.0
mayor_total = t1
mayor_clave = 0
write 'PRODUCCION ANUAL DE FABRICAS\n'
write 'Escribe el numero de fabricas:\n'
read n
i = 1
L1:
t2 = i <= n
ifFalse t2 goto L2
write 'Fabrica numero:\n'
write i
write '\n'
write 'Escribe la clave de esta fabrica:\n'
read clave
total = 0.0
julio = 0.0
mes = 1
L3:
t3 = mes <= 12
ifFalse t3 goto L4
t4 = mes == 1
ifFalse t4 goto L6
write 'Produccion de enero:\n'
L6:
t5 = mes == 2
ifFalse t5 goto L8
write 'Produccion de febrero:\n'
L8:
t6 = mes == 3
ifFalse t6 goto L10
write 'Produccion de marzo:\n'
L10:
t7 = mes == 4
ifFalse t7 goto L12
write 'Produccion de abril:\n'
L12:
t8 = mes == 5
ifFalse t8 goto L14
write 'Produccion de mayo:\n'
L14:
t9 = mes == 6
ifFalse t9 goto L16
write 'Produccion de junio:\n'
L16:
t10 = mes == 7
ifFalse t10 goto L18
write 'Produccion de julio:\n'
L18:
t11 = mes == 8
ifFalse t11 goto L20
write 'Produccion de agosto:\n'
L20:
t12 = mes == 9
ifFalse t12 goto L22
write 'Produccion de septiembre:\n'
L22:
t13 = mes == 10
ifFalse t13 goto L24
write 'Produccion de octubre:\n'
L24:
t14 = mes == 11
ifFalse t14 goto L26
write 'Produccion de noviembre:\n'
L26:
t15 = mes == 12
ifFalse t15 goto L28
write 'Produccion de diciembre:\n'
L28:
read produccion
t16 = total + produccion
total = t16
t17 = mes == 7
ifFalse t17 goto L30
julio = produccion
L30:
t18 = mes + 1
mes = t18
goto L3
L4:
write 'Resultado de la fabrica:\n'
write clave
write '\n'
write 'Produccion total anual:\n'
write total
write '\n'
t19 = total > mayor_total
ifFalse t19 goto L32
mayor_total = total
mayor_clave = clave
L32:
t20 = julio > 3000000.0
ifFalse t20 goto L34
write 'Fabrica con julio mayor a 3000000:\n'
write clave
L34:
t21 = i + 1
i = t21
goto L1
L2:
write 'Fabrica con mayor produccion anual:\n'
write mayor_clave
write '\n'
write 'Total producido:\n'
write mayor_total
