suma = 0.0
write 'Escribe el valor de N:\n'
read n
i = 1
signo = 1
L1:
t1 = i <= n
ifFalse t1 goto L2
t2 = signo == 1
ifFalse t2 goto L3
t3 = 1.0 / i
t4 = suma + t3
suma = t4
goto L4
L3:
t5 = 1.0 / i
t6 = suma - t5
suma = t6
L4:
t7 = 0 - signo
signo = t7
t8 = i + 1
i = t8
goto L1
L2:
write 'Resultado de la serie:\n'
write suma
