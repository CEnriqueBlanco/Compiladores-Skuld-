int n;
int a;
int b;
int temp;
int i;

cin >> n;

if (n == 0) {
    cout << "Fibonacci:";
    cout << 0;
} else {
    if (n == 1) {
        cout << "Fibonacci:";
        cout << 1;
    } else {
        a = 0;
        b = 1;
        i = 2;
        while (i <= n) {
            temp = a + b;
            a = b;
            b = temp;
            i = i + 1;
        }
        cout << "Fibonacci:";
        cout << b;
    }
}
