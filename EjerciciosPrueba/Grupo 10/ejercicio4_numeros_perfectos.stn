int n;
int i;
int d;
int suma;

cout << "Escribe el valor de N:\n";
cin >> n;

i = 1;
while (i <= n) {
    suma = 0;
    d = 1;
    while (d < i) {
        if (i % d == 0) {
            suma = suma + d;
        }
        d = d + 1;
    }
    if (suma == i) {
        cout << "Numero perfecto:\n";
        cout << i;
    }
    i = i + 1;
}
