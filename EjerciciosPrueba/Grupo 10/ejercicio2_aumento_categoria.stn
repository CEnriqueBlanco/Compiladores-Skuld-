int categoria;
float sueldo;
float aumento;
float nuevo;

cin >> categoria;
cin >> sueldo;

if (categoria == 1) {
    aumento = sueldo * 0.15;
} else {
    if (categoria == 2) {
        aumento = sueldo * 0.10;
    } else {
        if (categoria == 3) {
            aumento = sueldo * 0.08;
        } else {
            if (categoria == 4) {
                aumento = sueldo * 0.07;
            } else {
                aumento = 0.0;
            }
        }
    }
}

nuevo = sueldo + aumento;

cout << "Categoria:";
cout << categoria;
cout << "Nuevo sueldo:";
cout << nuevo;
