<> Prueba semántica 1: Programa válido y completo (sin errores)
<> Debe generar AST anotado y tabla de símbolos limpios

int temperatura = 37;
float presion = 101.325;
bool alarma = false;

function bool revisar_limite(int valor, int limite) {
    return valor > limite;
}

main {
    int umbral = 40;
    alarma = revisar_limite(temperatura, umbral);

    if (alarma) {
        cout("¡ALERTA! Temperatura fuera de rango: " + temperatura);
    } else {
        cout("Temperatura normal: " + temperatura);
    }

    int contador = 0;
    while (contador < 5) {
        cout("Iteracion: " + contador);
        contador = contador + 1;
    }

    float resultado = presion * 2;
    cout("Presion duplicada: " + resultado);
}
